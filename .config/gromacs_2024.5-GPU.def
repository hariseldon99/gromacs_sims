# filepath: /home/daneel/gitrepos/gromacs_sims/.config/gromacs_2024.5-GPU.def
# Updates to the original gromacs_2024.5.def to improve martini3 and charmm support for gromacs, 
# as well as insane mambrane builder for CG simulations. 
Bootstrap: docker
From: ubuntu:24.04
Stage: build

%labels
    APPLICATION GROMACS_2024.5-GPU
    AUTHOR Analabha Roy
    EMAIL daneel@utexas.edu
    YEAR 2026

%help
    GROMACS 2024.5 (GPU, conda build, incl amber99sb-ildn, charmm36 and martini3 ff) + ambertools + biobb + analysis stack.
    Launch Jupyter:
        singularity run --nv -B $PWD:/host_pwd --pwd /host_pwd <image>.sif jupyter
    Plain shell:
        singularity run --nv <image>.sif
    GROMACS:
        singularity run --nv <image>.sif gmx mdrun -s topol.tpr
    Run a command or script:
        singularity run --nv <image>.sif my_script.sh arg1 arg2

%environment
    TZ=UTC
    DEBIAN_FRONTEND=noninteractive
    MPLCONFIGDIR=$HOME/.matplotlib
    export TZ DEBIAN_FRONTEND MPLCONFIGDIR
    export PATH=/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
    
%runscript
    #!/bin/bash
    export MPLCONFIGDIR=$HOME/.matplotlib
    jupyter labextension list 2>&1 | tee $HOME/.jupyter/extension_check.log
    grep "not compatible" $HOME/.jupyter/extension_check.log && echo "Extension conflicts detected"
    if [ "$1" = "gmx" ]; then
        shift
        exec gmx "$@"
    elif [ "$1" = "jupyter" ]; then
        echo "Starting Notebook server on $HOSTNAME. Access via port 8888."
        shift
        jupyter lab --LabApp.extension_manager=readonly \
            --ip=0.0.0.0 --port=8888 --no-browser --allow-root \
            --NotebookApp.token='' --NotebookApp.password='' \
            --ServerApp.token='' --ServerApp.password='' \
            "$@"
    else
        /bin/bash "$@"
    fi

%post
        set -eux
        export DEBIAN_FRONTEND=noninteractive
        # Make CUDA version visible to solver before any mamba install
        export CONDA_OVERRIDE_CUDA=11.8

        # --- FIX: pin setuptools inside pip's PEP 517 *build isolation* envs ---
        # Several legacy scientific sdists (e.g. pandas==1.5.3, hard-pinned by
        # gmx_MMPBSA's setup.py) still `import pkg_resources` at build time.
        # pkg_resources was fully removed from setuptools as of 83.0 (deprecated
        # since 68.0). Pip populates each isolated build env with the newest
        # available setuptools regardless of what's pinned in the outer env, so
        # any package without cp312 wheels that needs to build from source will
        # fail with "ModuleNotFoundError: No module named 'pkg_resources'".
        # PIP_CONSTRAINT is honored by pip's build-isolation resolver (pip >=23.1)
        # as well as normal installs, so setting it once here covers both.
        echo "setuptools<81" > /tmp/build-constraints.txt
        export PIP_CONSTRAINT=/tmp/build-constraints.txt

        apt-get update
        apt-get install -y --no-install-recommends \
                build-essential wget ca-certificates git dos2unix zsh \
                dvipng texlive-latex-extra texlive-fonts-recommended cm-super \
                libxrender1 libxext6 libsm6 libice6
        apt-get clean
        rm -rf /var/lib/apt/lists/*

        # Miniforge (conda) install — pinned to a specific release for reproducibility
        MINIFORGE_VERSION="26.3.2-3"
        MINIFORGE_SHA256="848194851a98903134187fbb4ab50efe87b003e0c0f808f97644b7524a62bf2c"
        cd /tmp
        wget -q "https://github.com/conda-forge/miniforge/releases/download/${MINIFORGE_VERSION}/Miniforge3-${MINIFORGE_VERSION}-Linux-x86_64.sh" \
            -O Miniforge3-Linux-x86_64.sh
        echo "${MINIFORGE_SHA256}  Miniforge3-Linux-x86_64.sh" | sha256sum -c -
        bash Miniforge3-Linux-x86_64.sh -b -f -p /usr/local
        rm Miniforge3-Linux-x86_64.sh
        export PATH=/usr/local/bin:$PATH
        export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
        # Channels & solver
        conda config --system --add channels defaults
        conda config --system --add channels conda-forge
        conda config --system --add channels bioconda
        conda config --file /.condarc --add channels salilab
        conda config --system --set channel_priority flexible
        conda install -y mamba

        # Step 1: Install the CUDA/Python/GROMACS core first to anchor the solver
        # Ubuntu 24.04 ships zlib 1.3.x natively, matching conda-forge's zlib;
        # no pin needed and LuaTeX works correctly with text.usetex=True.
        mamba install -y \
                python=3.12 \
                cudatoolkit=11.8 \
                gromacs==2024.5=nompi_cuda_h5cb645a_0

        # Step 2: Scientific + MD + viz stack (solver is now anchored to py3.12+cuda11.8)
        # Group A: numerics/core (light, few exotic transitive deps)
        mamba install -y numpy scipy pandas tqdm 
        mamba install -y mpi4py scienceplots ipympl 
        mamba install -y h5py "networkx>=3.4.2" "setuptools<82" pip tabulate numba 
        mamba install -y dask dask-mpi scikit-learn

        # Group B: heavy chemistry/biophysics packages — historically the slowest,
        # most transitive-dependency-heavy solves in this stack (ambertools
        # especially is notorious for long solve times even on its own)
        # Check out prody: https://www.bahargroup.org/prody/
        # Check out alchemlyb: https://alchemlyb.readthedocs.io/en/stable/
        # Check out pdbfixer: https://github.com/pandegroup/pdbfixer
        # Check out lipyphilic: https://lipyphilic.readthedocs.io/en/latest/
        # Check out py3dmol: https://william-dawson.github.io/using-py3dmol.html
        mamba install -y ambertools acpype openbabel rdkit 
        mamba install -y mdanalysis mdtraj simpletraj 
        # Hangs here:
        mamba install -y parmed biopython prody alchemlyb pymbar pdbfixer lipyphilic pmda 
        mamba install -y nglview=3.*  py3dmol

        # Group C: Jupyter/viz stack (mostly independent of Group B)
        mamba install -y seaborn plotly jupyter jupyterlab=4.5.* \
                jupyter_server>=2.14 nbconvert jupyterlab-spellchecker \
                jupyterlab-git jupyterlab-lsp matplotlib-base pdb2pqr

        # DSSP installed as its own isolated solve — kept separate from the
        # Step 2 stack so its old libboost=1.73.0 pin can't force expensive
        # backtracking against ~30 other loosely-pinned packages/4 channels.
        mamba install -y -c salilab -c anaconda -c conda-forge dssp=3.0.0 libboost=1.73.0
        # Extra tools (some already provided inside ambertools; duplicates tolerated)
        pip install --no-cache-dir \
                amberutils \
                gromacs_py \
                importmonkey \
                ipyparallel \
                jupyterlab-execute-time \
                jupyterlab-code-formatter \
                biobb-common biobb-chemistry biobb-io biobb-model \
                biobb-structure-checking biobb-structure-utils biobb-analysis biobb-gromacs

        # gmx_MMPBSA installed separately with --no-deps: its setup.py hard-pins
        # numpy==1.26.4/pandas==1.5.3/matplotlib==3.7.3/scipy==1.14.1/mpi4py==4.0.1
        # for the maintainers' own reproducibility, not because those exact
        # versions are required at runtime. pandas==1.5.3 in particular has no
        # cp312 wheel and would otherwise force an sdist build (see PIP_CONSTRAINT
        # fix above). The mamba stack in Step 2 already satisfies every real
        # runtime dependency (numpy, pandas, matplotlib, seaborn, scipy, mpi4py,
        # parmed, tqdm), so --no-deps skips the problematic re-resolution entirely.
        pip install --no-cache-dir --no-deps gmx_MMPBSA

        # Enable nglview extension (JupyterLab 4 auto-detects, kept for safety)
        jupyter-nbextension enable nglview --py --sys-prefix || true

        # CHARMM36 update (replace old charmm36-jul2017.ff if present in gromacs template)
        wget -q "https://mackerell.umaryland.edu/download.php?filename=CHARMM_ff_params_files/charmm36-jul2022.ff.tgz" -O /tmp/charmm36.tgz

        tar -xzf /tmp/charmm36.tgz -C /tmp
        # Also place a clean copy in share/top for GMXLIB usage
        mkdir -p /usr/local/share/gromacs/top
        cp -r /tmp/charmm36-jul2022.ff /usr/local/share/gromacs/top/
        # MacKerell lab tarballs often use CRLF — fix in-place so GROMACS can parse forcefield.doc
        find /usr/local/share/gromacs/top/charmm36-jul2022.ff -type f | xargs dos2unix
        # Guarantee forcefield.doc exists with a one-line description (required by pdb2gmx).
        # Must end with a newline — GROMACS line-reader skips unterminated lines.
        printf 'CHARMM36m all-atom force field (July 2022)\n' \
            > /usr/local/share/gromacs/top/charmm36-jul2022.ff/forcefield.doc
        rm -rf /tmp/charmm36* 
        # Get the cgenff script for generating parameters for small molecules
        wget https://raw.githubusercontent.com/Lemkul-Lab/cgenff_charmm2gmx/refs/heads/main/cgenff_charmm2gmx.py -O /usr/local/bin/cgenff_charmm2gmx.py
        chmod +x /usr/local/bin/cgenff_charmm2gmx.py

        # Download Martini 3 force field repository and install forcefield files for GROMACS
        git clone --depth 1 https://github.com/marrink-lab/martini-forcefields /tmp/martini3 || true

        # Create destination in conda GROMACS top directory and copy force field files
        mkdir -p /usr/local/share/gromacs/top/martini3.ff
        # try common locations inside the repo (be permissive)
        if [ -d /tmp/martini3/martini_forcefields ]; then
                cp -r /tmp/martini3/martini_forcefields/regular/v3.0.0/gmx_files/* /usr/local/share/gromacs/top/martini3.ff/
                cp -r /tmp/martini3/martini_forcefields/regular/v3.0.0/gmx_files_contributed/* /usr/local/share/gromacs/top/martini3.ff/
        else
                cp -r /tmp/martini3/martini_forcefields/regular/v3.0.0/gmx_files/* /usr/local/share/gromacs/top/martini3.ff/ || true
                cp -r /tmp/martini3/martini_forcefields/regular/v3.0.0/gmx_files_contributed/* /usr/local/share/gromacs/top/martini3.ff/ || true
        fi
        # Extract open-beta-only lipid tail combinations (not carried into the 2025
        # refined M3-Lipid-Parameters release) from the old monolithic phospholipids
        # bundle, before that bundle gets replaced. See conversation log for how this
        # target list and extraction logic were derived/validated.
        python3 <<'PYEOF'
            import re

            missing = {"DIPA","DIPC","DIPE","DIPG","DIPS","JFPG","JPPG","LPPA","LPPC","LPPE",
                    "LPPG","LPPS","OPPG","PGPA","PGPC","PGPE","PGPG","PGPS","PRPA","PRPC",
                    "PRPE","PRPG","PRPS","PUPA","PUPC","PUPE","PUPS"}

            src = "/usr/local/share/gromacs/top/martini3.ff/martini_v3.0.0_phospholipids_v1.itp"
            with open(src) as f:
                text = f.read()

            # tolerate whitespace inside brackets: [moleculetype] or [ moleculetype ]
            parts = re.split(r'(?=^\[\s*moleculetype\s*\]\s*$)', text, flags=re.M)
            blocks = [p for p in parts if re.match(r'^\[\s*moleculetype\s*\]', p.strip())]

            molname_re = re.compile(r'^\s*([A-Za-z0-9]{2,8})\s+\d+\s*$', re.M)
            found = {}
            for b in blocks:
                body = b.split("\n", 1)[1] if "\n" in b else ""
                m = molname_re.search(body)
                name = m.group(1) if m else "UNRESOLVED"
                found.setdefault(name, []).append(b)

            target_found = {k: v for k, v in found.items() if k in missing}
            still_missing = missing - target_found.keys()
            if still_missing:
                raise SystemExit(f"FATAL: extraction incomplete, missing: {sorted(still_missing)}")
            if any(len(v) > 1 for v in found.values()):
                raise SystemExit(f"FATAL: duplicate moleculetype names detected during extraction")

            out = "/usr/local/share/gromacs/top/martini3.ff/martini_v3.0.0_phospholipids_openbeta_extra.itp"
            with open(out, "w") as f:
                f.write("; Open-beta lipid tail combinations not carried into M3-Lipid-Parameters (2025)\n\n")
                for name, blist in target_found.items():
                    for b in blist:
                        f.write(b)
            print(f"Extracted {len(target_found)} open-beta-only lipids to {out}")
            PYEOF
        # Refined Martini 3 lipidome (supersedes the old bundled phospholipids_v1.itp,
        # now safe to remove since its unique content was extracted above)
        rm -f /usr/local/share/gromacs/top/martini3.ff/martini_v3.0.0_phospholipids_v1.itp
        git clone --depth 1 https://github.com/Martini-Force-Field-Initiative/M3-Lipid-Parameters /tmp/m3lipids || true
        cp /tmp/m3lipids/ITPs/*.itp /usr/local/share/gromacs/top/martini3.ff/
        rm -rf /tmp/m3lipids

        # Install martinize2/vermouth and insane for coarse graining (pip only — not on conda-forge)
        pip install --no-cache-dir vermouth insane
        pip install git+https://github.com/marrink-lab/vermouth-martinize.git#vermouth
        # NOTE: the old "re-pin setuptools<82 after pip installs" step that used to
        # live here is no longer needed — PIP_CONSTRAINT set at the top of %post
        # keeps every pip build-isolation env (and every plain install) on a
        # pkg_resources-capable setuptools for the rest of this script.

        # Install custom insane.py from compchems (Python 2 script — convert to Python 3 in-place)
        wget -O /usr/local/bin/insane_compchems.py https://www.compchems.com/gromacs_cg/insane.py
        2to3 -w /usr/local/bin/insane_compchems.py
        rm -f /usr/local/bin/insane_compchems.py.bak
        chmod +x /usr/local/bin/insane_compchems.py

        # Cleanup temporary clones
        rm -rf /tmp/martini3 

        # Clean
        mamba clean -ay
        find /usr/local -name "__pycache__" -type d -exec rm -rf {} +
        mkdir -p /root/.jupyter

        echo "DONE: GROMACS 2024.5 GPU + bio stack."