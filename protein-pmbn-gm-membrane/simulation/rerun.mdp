integrator              = md
dt                      = 0.002
nsteps                  = 5000000
nstxout-compressed = 0
nstxout = 0
nstvout = 0
nstfout = 0
nstcalcenergy = 1
nstenergy = 1
nstlog                  = 1000
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
;
tcoupl                  = v-rescale
tc_grps                 = MEMB SOLV
tau_t                   = 1.0 1.0
ref_t                   = 310.15 310.15
;
pcoupl                  = C-rescale
pcoupltype              = semiisotropic
tau_p                   = 5.0
compressibility         = 4.5e-5  4.5e-5
ref_p                   = 1.0     1.0
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = MEMB SOLV
energygrps = PMB_MOA1 PMB_DAB2 PMB_THR3 PMB_DAB4 PMB_DAB5 PMB_DAB6 PMB_DPH7 PMB_LEU8 PMB_DAB9 PMB_DAB10 PMB_THR11 LPS PPPE PVPG PVCL2
