;; minim.mdp - used as input into grompp to generate em.tpr
; Parameters describing what to do, when to stop and what to save
define                  = -DFLEXIBLE   ; Allows water/peptides to relax fully

integrator      = steep         ; Algorithm (steep = steepest descent minimization)
;nstxout-compressed     = 1       ; xtc compressed trajectory output every 1000 steps (100 ps)
;compressed-x-precision = 1       ; precision with which to write to the compressed trajectory file

emtol           = 10.0        ; ighter tolerance ensures a very stable starting structure
emstep                  = 0.01         ; Faster, robust relaxation for crowded boxes
nsteps          = 50000         ; Maximum number of (minimization) steps to perform

; MANDATORY MARTINI 3 NON-BONDED PARAMETERS
cutoff-scheme            = Verlet
nstlist                  = 20
ns-type                  = grid
pbc                      = xyz
verlet-buffer-tolerance  = 0.005

coulombtype              = cutoff
coulomb-modifier         = Potential-shift-verlet
rcoulomb                 = 1.1
epsilon_r                = 15          ; Martini 3 screening constant
vdwtype                  = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1

constraints              = none
constraint_algorithm     = Lincs
unconstrained_start      = no
lincs_order              = 4
lincs_warnangle          = 90
