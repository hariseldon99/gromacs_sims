#!/bin/bash
#--------------------------------------------------
# PBS SETTINGS
#--------------------------------------------------
#PBS -N ku04-gm-eqprd
#PBS -q workq
#PBS -l select=1:ncpus=24:mpiprocs=24:host=kuhpcgn2
#PBS -o ku04-gm-eqprd.out
#PBS -j oe
#PBS -l walltime=168:00:00
#--------------------------------------------------

set -euo pipefail

#--------------------------------------------------
# USER SETTINGS
#--------------------------------------------------

# Toggle equilibration stages (6.1 -> 6.6)
RUN_EQUIL=true

# Production chunk range
# For resume after completed step7_6, set to START_CHUNK=7, else 1
START_CHUNK=1
MAX_CHUNK=10

# Singularity container
SIF_PATH="/home/arunima/images/gromacs_2024.5-GPU.sif"

#--------------------------------------------------
# INITIALIZATION
#--------------------------------------------------

cd "$PBS_O_WORKDIR"

LOGFILE="wrapper_$(date +%Y%m%d_%H%M%S).log"

# Persistent unbuffered logging
exec > >(stdbuf -oL tee -a "$LOGFILE")
exec 2>&1

echo "================================================="
echo "PBS JOB START"
echo "================================================="
echo "Date        : $(date)"
echo "Hostname    : $(hostname)"
echo "Working dir : $(pwd)"
echo "PBS_JOBID   : ${PBS_JOBID}"
echo "PBS_JOBNAME : ${PBS_JOBNAME}"
echo "================================================="

#--------------------------------------------------
# MODULES
#--------------------------------------------------

module load ohpc
module load cuda

export PBS_NCPUS=$(wc -l "$PBS_NODEFILE" | awk '{print $1}')

echo "[INFO] Detected PBS_NCPUS=${PBS_NCPUS}"

#--------------------------------------------------
# SINGULARITY WRAPPER
#--------------------------------------------------

SINGULARITY() {
    singularity exec \
        --nv \
        -B "${PWD}:/host_pwd" \
        --pwd /host_pwd \
        "$SIF_PATH" "$@"
}

#--------------------------------------------------
# START TIMER
#--------------------------------------------------

start=$(date +%s.%N)

#--------------------------------------------------
# EQUILIBRATION
#--------------------------------------------------

if [ "$RUN_EQUIL" = true ]; then

    echo
    echo "================================================="
    echo "RUNNING EQUILIBRATION STAGES"
    echo "================================================="

    for step in 6.1 6.2 6.3 6.4 6.5 6.6; do

        prev=$(echo $step | awk -F. '{
            if ($2==1)
                print "em";
            else
                printf "step%s.%s", $1, $2-1
        }')

        echo
        echo "-------------------------------------------------"
        echo "[$(date)] Starting equilibration step${step}"
        echo "Previous structure: ${prev}"
        echo "-------------------------------------------------"

        test -f "${prev}.gro"

        echo "[INFO] Running grompp for step${step}"

        SINGULARITY bash -c "
            gmx grompp \
                -f step${step}_equilibration.mdp \
                -c ${prev}.gro \
                -r system.gro \
                -p topol.top \
                -n index.ndx \
                -o step${step}.tpr \
                -maxwarn 5
        "

        test -f "step${step}.tpr"

        echo "[INFO] Starting mdrun for step${step}"

        SINGULARITY bash -c "
            gmx mdrun \
                -nobackup \
                -nocopyright \
                -v \
                -deffnm step${step} \
                -pin on \                
                -deffnm step${step} \
                -nb gpu \
                -pme gpu \
                -bonded gpu \
                -ntmpi 1 \
                -ntomp ${PBS_NCPUS} \
                -gpu_id 0
        "

        echo "[INFO] mdrun completed for step${step}"

        test -f "step${step}.gro"
        test -f "step${step}.cpt"
        test -f "step${step}.log"

        echo ">>> Completed equilibration step${step}"
        echo ">>> Checkpoint: step${step}.cpt"

    done

    echo
    echo "================================================="
    echo "ALL EQUILIBRATION STAGES COMPLETE"
    echo "================================================="

else

    echo
    echo "================================================="
    echo "SKIPPING EQUILIBRATION STAGES"
    echo "RUN_EQUIL=false"
    echo "================================================="

fi

#--------------------------------------------------
# PRODUCTION SAFETY CHECK
#--------------------------------------------------

if [ "$START_CHUNK" -gt 1 ]; then

    prev_chunk=$((START_CHUNK - 1))

    echo
    echo "[INFO] Resume mode detected"
    echo "[INFO] Expecting checkpoint from step7_${prev_chunk}"

    test -f "step7_${prev_chunk}.gro"
    test -f "step7_${prev_chunk}.cpt"

fi

#--------------------------------------------------
# PRODUCTION MD
#--------------------------------------------------

cnt_start=$START_CHUNK
set_cntmax=$MAX_CHUNK

echo
echo "================================================="
echo "STARTING PRODUCTION RUNS"
echo "Chunks ${cnt_start} -> ${set_cntmax}"
echo "================================================="

for cnt in $(seq ${cnt_start} ${set_cntmax}); do

    pcnt=$((cnt - 1))
    istep="step7_${cnt}"

    echo
    echo "-------------------------------------------------"
    echo "[$(date)] Starting production chunk ${cnt}/${set_cntmax}"
    echo "Current chunk : ${istep}"
    echo "-------------------------------------------------"

    if [ ${cnt} -eq 1 ]; then

        pstep="step6.6"

        test -f "${pstep}.gro"

        echo "[INFO] Running grompp for ${istep}"

        SINGULARITY bash -c "
            gmx grompp \
                -f step7_production.mdp \
                -c ${pstep}.gro \
                -p topol.top \
                -n index.ndx \
                -o ${istep}.tpr \
                -maxwarn 2
        "

    else

        pstep="step7_${pcnt}"

        test -f "${pstep}.gro"
        test -f "${pstep}.cpt"

        echo "[INFO] Running grompp for ${istep}"

        SINGULARITY bash -c "
            gmx grompp \
                -f step7_production.mdp \
                -c ${pstep}.gro \
                -t ${pstep}.cpt \
                -p topol.top \
                -n index.ndx \
                -o ${istep}.tpr \
                -maxwarn 2
        "

    fi

    test -f "${istep}.tpr"

    echo "[INFO] Starting mdrun for ${istep}"

    SINGULARITY bash -c "
        gmx mdrun \
            -nobackup \
            -nocopyright \
            -v \
            -deffnm ${istep} \
            -pin on \
            -nb gpu \
            -pme gpu \
            -bonded gpu \
            -ntmpi 1 \
            -nt ${PBS_NCPUS} \
            -gpu_id 0
    "

    echo "[INFO] mdrun completed for ${istep}"

    test -f "${istep}.gro"
    test -f "${istep}.cpt"
    test -f "${istep}.log"

    echo ">>> Completed production chunk ${cnt}/${set_cntmax}"
    echo ">>> Checkpoint: ${istep}.cpt"

done

echo
echo "================================================="
echo "ALL PRODUCTION CHUNKS COMPLETE"
echo "================================================="

#--------------------------------------------------
# POST-PROCESSING
#--------------------------------------------------

echo
echo "================================================="
echo "POST-PROCESSING"
echo "================================================="

rm -f traj_prod.xtc
rm -f traj_whole.xtc
rm -f traj_dry.xtc

xtc_list=$(ls -v step7_*.xtc 2>/dev/null | tr '\n' ' ')

if [ -z "${xtc_list}" ]; then

    echo "[WARNING] No production XTC files found."
    echo "[WARNING] Skipping post-processing."

else

    echo "[INFO] Concatenating trajectories"

    SINGULARITY bash -c "
        gmx trjcat \
            -f ${xtc_list} \
            -o traj_prod.xtc \
            -cat
    "

    test -f traj_prod.xtc

    echo ">>> Concatenated trajectory created: traj_prod.xtc"

    echo "System" > trjconv_whole.in

    echo "[INFO] Running whole-PBC repair"

    SINGULARITY bash -c "
        gmx trjconv \
            -s step7_1.tpr \
            -f traj_prod.xtc \
            -pbc whole \
            -o traj_whole.xtc \
            < trjconv_whole.in
    "

    test -f traj_whole.xtc

    echo ">>> Whole trajectory created: traj_whole.xtc"

    printf "MEMB\nMEMB\nMEMB\n" > trjconv_dry.in

    echo "[INFO] Creating dry clustered trajectory"

    SINGULARITY bash -c "
        gmx trjconv \
            -s step7_1.tpr \
            -f traj_whole.xtc \
            -n index.ndx \
            -center \
            -pbc cluster \
            -ur compact \
            -o traj_dry.xtc \
            < trjconv_dry.in
    "

    test -f traj_dry.xtc

    echo ">>> Dry trajectory created: traj_dry.xtc"

    echo "[INFO] Creating dry TPR file matching dry clustered trajectory selections"

    printf "MEMB\nMEMB\n" > convert_tpr_dry.in

    SINGULARITY bash -c "
        gmx convert-tpr \
            -s step7_1.tpr \
            -n index.ndx \
            -o traj_dry.tpr \
            < convert_tpr_dry.in
    "

    test -f traj_dry.tpr

    echo ">>> Dry TPR file created: traj_dry.tpr"

    rm -f traj_whole.xtc
    rm -f trjconv_whole.in
    rm -f trjconv_dry.in

    echo "[INFO] Intermediate files cleaned"

fi

#--------------------------------------------------
# END TIMER
#--------------------------------------------------

end=$(date +%s.%N)

RUNTIME=$(echo "$end - $start" | bc -l)

echo
echo "================================================="
echo "JOB COMPLETE"
echo "================================================="
echo "Runtime: ${RUNTIME} sec"
echo "================================================="

#--------------------------------------------------
# NOTIFICATION
#--------------------------------------------------

NTFY_URL="https://ntfy.sh/kuhpchn"

MESSAGE="PBS job complete: ${PBS_JOBNAME} (${PBS_JOBID}) runtime=${RUNTIME} sec"

echo "[INFO] Sending ntfy notification"

timeout 20 curl -X POST -d "$MESSAGE" "$NTFY_URL" || true

echo
echo "[$(date)] Script exiting normally."
