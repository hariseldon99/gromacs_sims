#!/bin/bash
#--------------------------------------------------
# PBS SETTINGS
#--------------------------------------------------
#PBS -N ku04-gm-eqprd
#PBS -q workq
#PBS -l select=1:ncpus=48:mpiprocs=48:host=kuhpcgn2
#PBS -o ku04-gm-eqprd.out
#PBS -j oe
#PBS -l walltime=168:00:00
#--------------------------------------------------

set -euo pipefail

#--------------------------------------------------
# USER SETTINGS
#--------------------------------------------------

# Toggle equilibration 
RUN_EQUIL=true

# Toggle Production run
RUN_PROD=true #Set to false if only PP is desired

RESUME_MD=false #Set to true if resuming from chkpt

EM_OUT="em.gro"
EQUI_MDP="npt.mdp"
MD_MDP="md.mdp"


# Singularity container
SIF_PATH="/home/arunima/images/gromacs_2024.5.1-GPU_20260718.sif"

#--------------------------------------------------
# INITIALIZATION
#--------------------------------------------------

cd "$PBS_O_WORKDIR"

LOGFILE="wrapper_$(date +%Y%m%d_%H%M%S).log"

# Persistent unbuffered logging
exec > >(stdbuf -oL tee -a "$LOGFILE")
exec 2>&1

echo "================================================="
echo "PBS JOB START"
echo "================================================="
echo "Date        : $(date)"
echo "Hostname    : $(hostname)"
echo "Working dir : $(pwd)"
echo "PBS_JOBID   : ${PBS_JOBID}"
echo "PBS_JOBNAME : ${PBS_JOBNAME}"
echo "================================================="

#--------------------------------------------------
# MODULES
#--------------------------------------------------

module load ohpc
module load cuda

export PBS_NCPUS=$(wc -l "$PBS_NODEFILE" | awk '{print $1}')

echo "[INFO] Detected PBS_NCPUS=${PBS_NCPUS}"

#--------------------------------------------------
# SINGULARITY WRAPPER
#--------------------------------------------------

SINGULARITY() {
    singularity exec \
        --nv \
        -B "${PWD}:/host_pwd" \
        --pwd /host_pwd \
        "$SIF_PATH" "$@"
}

#--------------------------------------------------
# START TIMER
#--------------------------------------------------

start=$(date +%s.%N)

#--------------------------------------------------
# EQUILIBRATION
#--------------------------------------------------

if [ "$RUN_EQUIL" = true ]; then

    echo
    echo "================================================="
    echo "RUNNING EQUILIBRATION STAGE"
    echo "================================================="


    echo "[INFO] Running grompp for equilibration"

    SINGULARITY bash -c "
        gmx grompp \
            -f ${EQUI_MDP} \
            -c ${EM_OUT}.gro \
            -r ${EM_OUT}.gro \
            -p topol.top \
            -n index.ndx \
            -o npt.tpr \
            -maxwarn 5
    "

    test -f "npt.tpr"

    echo "[INFO] Starting mdrun for equilibration"

    SINGULARITY bash -c "
        gmx mdrun \
            -nobackup \
            -nocopyright \
            -v \
            -deffnm npt \
            -nb gpu \
            -nt ${PBS_NCPUS} \
            -gpu_id 0
    "

    echo "[INFO] mdrun completed for equilibration"

    test -f "npt.gro"
    test -f "npt.cpt"
    test -f "npt.log"

    echo ">>> Completed equilibration step"
    echo ">>> Checkpoint: npt.cpt"

    echo
    echo "================================================="
    echo "EQUILIBRATION  COMPLETE"
    echo "================================================="

else

    echo
    echo "================================================="
    echo "SKIPPING EQUILIBRATION"
    echo "RUN_EQUIL=false"
    echo "================================================="

fi
#--------------------------------------------------
# RESUME CHECKPOINT OR START NEW PRODUCTION
#--------------------------------------------------
if [ "$RESUME_MD" = true ]; then

    echo
    echo "================================================="
    echo "RESUMING PRODUCTION FROM CHECKPOINT"
    echo "RESUME_MD=true"
    echo "================================================="

    if [ ! -f "md.cpt" ]; then
        echo "[ERROR] Checkpoint file md.cpt not found. Cannot resume."
        exit 1
    fi
    echo "[INFO] resuming from checkpoint md.cpt"

    SINGULARITY bash -c "
        gmx mdrun \
            -nobackup \
            -nocopyright \
            -v \
            -deffnm md \
            -cpi md.cpt \
            -nb gpu \
            -nt ${PBS_NCPUS} \
            -gpu_id 0
    "
else
    if [ "$RUN_PROD" = true ]; then
        echo
        echo "================================================="
        echo "STARTING NEW PRODUCTION RUN"
        echo "RESUME_MD=false"
        echo "================================================="
        
        echo "[INFO] Running grompp for production"

        SINGULARITY bash -c "
            gmx grompp \
                -f ${MD_MDP} \
                -c npt.gro \
                -p topol.top \
                -n index.ndx \
                -o md.tpr \
                -t npt.cpt \
                -maxwarn 2
        "

        test -f "md.tpr"

        echo "[INFO] Starting mdrun for production"

        SINGULARITY bash -c "
            gmx mdrun \
                -nobackup \
                -nocopyright \
                -v \
                -deffnm md \
                -nb gpu \
                -nt ${PBS_NCPUS} \
                -gpu_id 0
        "
        echo "[INFO] mdrun completed for production"

        test -f "md.gro"
        test -f "md.cpt"
        test -f "md.log"

        echo ">>> Checkpoint: md.cpt"

        echo
        echo "================================================="
        echo "PRODUCTION COMPLETE"
        echo "================================================="
    else
        echo
        echo "================================================="
        echo "SKIPPING PRODUCTION RUN"
        echo "RUN_PROD=false"
        echo "================================================="
    fi        
fi

#--------------------------------------------------
# POST-PROCESSING
#--------------------------------------------------

echo
echo "================================================="
echo "POST-PROCESSING"
echo "================================================="

rm -f traj_prod.xtc
rm -f traj_whole.xtc
rm -f traj_nojump.xtc
rm -f traj_dry.xtc

xtc_list=$(ls -v md*.xtc 2>/dev/null | tr '\n' ' ')

if [ -z "${xtc_list}" ]; then

    echo "[WARNING] No production XTC files found."
    echo "[WARNING] Skipping post-processing."

else

    echo "[INFO] Concatenating trajectories sequentially"

    # Removed -cat because the chunks should possess native, sequential time markers
    bash -c "
        gmx trjcat \
            -f ${xtc_list} \
            -o traj_prod.xtc
    "

    test -f traj_prod.xtc

    echo ">>> Concatenated trajectory created: traj_prod.xtc"

    echo "System" > trjconv_whole.in

    echo "[INFO] Running whole-PBC repair"

    bash -c "
        gmx trjconv \
            -s md.tpr \
            -f traj_prod.xtc \
            -pbc whole \
            -o traj_whole.xtc \
            < trjconv_whole.in
    "

    test -f traj_whole.xtc

    echo ">>> Whole trajectory created: traj_whole.xtc"

    echo "System" > trjconv_nojump.in

    echo "[INFO] Running nojump to remove PBC-crossing artifacts"

    bash -c "
        gmx trjconv \
            -s md.tpr \
            -f traj_whole.xtc \
            -pbc nojump \
            -o traj_nojump.xtc \
            < trjconv_nojump.in
    "

    test -f traj_nojump.xtc

    echo ">>> Nojump trajectory created: traj_nojump.xtc"

    rm -f traj_whole.xtc
    rm -f trjconv_whole.in
    rm -f trjconv_nojump.in
fi

#--------------------------------------------------
# END TIMER
#--------------------------------------------------

end=$(date +%s.%N)

RUNTIME=$(echo "$end - $start" | bc -l)

echo
echo "================================================="
echo "JOB COMPLETE"
echo "================================================="
echo "Runtime: ${RUNTIME} sec"
echo "================================================="

#--------------------------------------------------
# NOTIFICATION
#--------------------------------------------------

NTFY_URL="https://ntfy.sh/kuhpchn"

MESSAGE="PBS job complete: ${PBS_JOBNAME} (${PBS_JOBID}) runtime=${RUNTIME} sec"

echo "[INFO] Sending ntfy notification"

timeout 20 curl -X POST -d "$MESSAGE" "$NTFY_URL" || true

echo
echo "[$(date)] Script exiting normally."
